# =============================================================================
# Solid sphere moving in an outer dipole field
# =============================================================================

mass 0.02
radius 0.01
charge 0.0

magneticMoment 0.0 0.0 1.00
magneticPolarizability 0 0 0  0 0 0  0 0 0
inertia 8.0e-7 0 0  0 8.0e-7 0  0 0 8.0e-7


position 0.0 0.0 0.0

velocity 0.0 0.0 0.0
omega 0.0 0.0 100.0
quaternion 1.0 0.0 0.0 0.0

solverMode dAlembert

constraint rolling
normal 0.0 0.0 1.0

gravityType uniform
gravity 0.0 0.0 -9.81

emType magDipole
dipoleCount 1

# Equilateral triangle of circumradius 1.0, located 0.35 below the plane.
dipolePosition1 0.100 0.000 -0.0050
# dipolePosition2 -0.0525, 0.0909326674, 0.0050
# dipolePosition3 -0.0525, -0.0909326674, 0.0050

# All source dipoles point upward.
dipoleMoment1 0.0 0.0 -1.0
# dipoleMoment2 0.0 0.0 1.0
# dipoleMoment3 0.0 0.0 1.0

# SI: 1e-7 = mu0/(4*pi)
dipoleFieldScale 1.0e-7

# Hard exclusion radius around each mathematical point dipole.
dipoleMinimumDistance 0.001

airType sphere
airDensity 1.225
airDynamicViscosity 0.05
airDragCoefficient 0.0
airRotationalDragCoefficient 0.0
airVelocity 0.0 0.0 0.0
airAngularVelocity 0.0 0.0 0.0

rollingResistanceType none

dt 1e-4
tEnd 10.0
