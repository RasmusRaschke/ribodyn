# Exact rolling constraint with regularized Coulomb rolling resistance.
mass 1.0
radius 0.1
charge 0.0
magneticMoment 0.0 0.0 0.0
magneticPolarizability 0 0 0  0 0 0  0 0 0
inertia 0.004 0 0  0 0.004 0  0 0 0.004

position 0.0 0.0 0.1
velocity 2.0 0.0 0.0
omega 0.0 20.0 0.0
quaternion 1.0 0.0 0.0 0.0

solverMode dAlembert
constraint rolling
normal 0.0 0.0 1.0

gravityType uniform
gravity 0.0 0.0 -9.81

emType none

airType none

rollingResistanceType coulomb
rollingFrictionCoefficient 0.03
rollingFrictionSmoothingSpeed 0.02
surfaceVelocity 0.0 0.0 0.0
# normalLoad may be omitted for a fixed plane in uniform gravity.

dt 0.0005
tEnd 8.0
