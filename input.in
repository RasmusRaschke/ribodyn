# Rolling sphere on a horizontal plane
# Input format: key followed by whitespace-separated value(s)
# Body
mass 1.0
radius 0.1
charge 0.0
magneticMoment 0.0 0.0 0.0

# Solid sphere: I = (2/5) m R^2 = 0.004 kg m^2
# Matrix entries are row-major
inertia 0.004 0.0 0.0  0.0 0.004 0.0  0.0 0.0 0.004

# Initial state
position 0.0 0.0 0.1
velocity 1.0 0.0 0.0
omega 0.0 10.0 0.0

# Quaternion order: w x y z
quaternion 1.0 0.0 0.0 0.0

# Framework selection
solverMode dAlembert

constraint rolling
normal 0.0 0.0 1.0

gravityType uniform
gravity 0.0 0.0 -9.81

emType none

# Integration
dt 0.0001
tEnd 1.0
